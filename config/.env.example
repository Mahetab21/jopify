NODE_ENV=development
PORT=5000
DB_URL=mongodb://127.0.0.1:27017/jobify
SALT_ROUND=12
APPLICATION_NAME=jobify
FRONTEND_ORIGIN=http://localhost:3000
# Generate four DIFFERENT secrets: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_USER=
ACCESS_TOKEN_ADMIN=
REFRESH_TOKEN_USER=
REFRESH_TOKEN_ADMIN=
BEARER_USER=Bearer
BEARER_ADMIN=Bearer
# Gmail address and app password, required for email registration/reset
EMAIL_USER=
EMAIL_PASSWORD=
# Optional until Google login or file uploads are used
WEB_CLIENT_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
