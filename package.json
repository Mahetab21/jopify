{
  "name": "jobify",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start:dev": "npm run build && concurrently -k \"tsc --watch\" \"nodemon --watch dist dist/index.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb",
    "recruitment",
    "socket-io"
  ],
  "author": "Mahitab Ayman",
  "license": "ISC",
  "description": "Jobify recruitment API with role-based access, job applications, S3 uploads and real-time messaging.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "nodemailer": "10.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/socket.io": "^3.0.1",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahetab21/jopify.git"
  }
}
